# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar OAuth (optional — enables /calendar Google sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
NEXT_PUBLIC_SITE_URL=

# AI features (optional — enables GPT-4o shift parsing and the AI planner;
# falls back to regex/rule-based logic when unset)
OPENAI_API_KEY=

# Durable rate limiting (optional — falls back to in-memory per-instance
# limiting when unset; get free values at upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error tracking (optional — no-ops when unset; get a DSN at sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
